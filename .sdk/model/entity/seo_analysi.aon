# Entity: seo_analysi

main: kit: entity: seo_analysi: {

  alias: field: {}

  fields: [
    {
      name: "headings"
      req: false
      short: "Heading tags analysis"
      type: "`$OBJECT`"
    }
    {
      name: "images"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "metaDescription"
      req: false
      short: "Meta description"
      type: "`$STRING`"
    }
    {
      name: "score"
      req: false
      short: "Overall SEO score"
      type: "`$NUMBER`"
    }
    {
      format: "date-time"
      name: "timestamp"
      req: false
      short: "Timestamp of the audit"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Page title"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "The audited URL"
      type: "`$STRING`"
    }
  ]

  name: "seo_analysi"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "https://example.com"
                kind: "query"
                name: "url"
                orig: "url"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /api/seo-audit"
            json: "{\"operationId\":\"seoAudit\",\"parameters\":[{\"description\":\"The URL of the website to audit\",\"in\":\"query\",\"name\":\"url\",\"required\":true,\"schema\":{\"example\":\"https://example.com\",\"format\":\"uri\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"headings\":{\"description\":\"Heading tags analysis\",\"properties\":{\"h1\":{\"description\":\"Number of H1 tags\",\"type\":\"integer\"},\"h2\":{\"description\":\"Number of H2 tags\",\"type\":\"integer\"}},\"type\":\"object\"},\"images\":{\"properties\":{\"missingAlt\":{\"description\":\"Images missing alt text\",\"type\":\"integer\"},\"total\":{\"description\":\"Total number of images\",\"type\":\"integer\"}},\"type\":\"object\"},\"metaDescription\":{\"description\":\"Meta description\",\"type\":\"string\"},\"score\":{\"description\":\"Overall SEO score\",\"type\":\"number\"},\"timestamp\":{\"description\":\"Timestamp of the audit\",\"format\":\"date-time\",\"type\":\"string\"},\"title\":{\"description\":\"Page title\",\"type\":\"string\"},\"url\":{\"description\":\"The audited URL\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Successful response with SEO audit results\"},\"400\":{\"description\":\"Bad request - Invalid URL parameter\"},\"500\":{\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/api/seo-audit"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "seo-audit"
            }
          ]
          select: {
            exist: [
              "url"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
