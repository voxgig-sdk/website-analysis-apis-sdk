# Entity: seo_analysi

main: kit: entity: seo_analysi: {

  alias: field: {}

  fields: [
    {
      name: "headings"
      req: false
      short: "Heading tags analysis"
      type: "`$OBJECT`"
    }
    {
      name: "images"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "metaDescription"
      req: false
      short: "Meta description"
      type: "`$STRING`"
    }
    {
      name: "score"
      req: false
      short: "Overall SEO score"
      type: "`$NUMBER`"
    }
    {
      name: "timestamp"
      req: false
      short: "Timestamp of the audit"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Page title"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "The audited URL"
      type: "`$STRING`"
    }
  ]

  name: "seo_analysi"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "https://example.com"
                kind: "query"
                name: "url"
                orig: "url"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/seo-audit"
          parts: [
            "api"
            "seo-audit"
          ]
          select: {
            exist: [
              "url"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
