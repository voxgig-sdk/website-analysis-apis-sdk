# Entity: performance

main: kit: entity: performance: {

  alias: field: {}

  fields: [
    {
      name: "loadTime"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "pageSize"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "requests"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "timestamp"
      req: false
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "performance"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "https://example.com"
                kind: "query"
                name: "url"
                orig: "url"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/performance"
          parts: [
            "api"
            "performance"
          ]
          select: {
            exist: [
              "url"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
