# Entity: performance

main: kit: entity: performance: {

  alias: field: {}

  fields: [
    {
      name: "loadTime"
      req: false
      short: "Page load time in milliseconds"
      type: "`$NUMBER`"
    }
    {
      name: "pageSize"
      req: false
      short: "Total page size in bytes"
      type: "`$INTEGER`"
    }
    {
      name: "requests"
      req: false
      short: "Number of HTTP requests"
      type: "`$INTEGER`"
    }
    {
      format: "date-time"
      name: "timestamp"
      req: false
      short: "Timestamp of the analysis"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "The analyzed URL"
      type: "`$STRING`"
    }
  ]

  name: "performance"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "https://example.com"
                kind: "query"
                name: "url"
                orig: "url"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /api/performance"
            json: "{\"operationId\":\"measurePerformance\",\"parameters\":[{\"description\":\"The URL of the website to analyze\",\"in\":\"query\",\"name\":\"url\",\"required\":true,\"schema\":{\"example\":\"https://example.com\",\"format\":\"uri\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"loadTime\":{\"description\":\"Page load time in milliseconds\",\"type\":\"number\"},\"pageSize\":{\"description\":\"Total page size in bytes\",\"type\":\"integer\"},\"requests\":{\"description\":\"Number of HTTP requests\",\"type\":\"integer\"},\"timestamp\":{\"description\":\"Timestamp of the analysis\",\"format\":\"date-time\",\"type\":\"string\"},\"url\":{\"description\":\"The analyzed URL\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Successful response with performance metrics\"},\"400\":{\"description\":\"Bad request - Invalid URL parameter\"},\"500\":{\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/api/performance"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "performance"
            }
          ]
          select: {
            exist: [
              "url"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
