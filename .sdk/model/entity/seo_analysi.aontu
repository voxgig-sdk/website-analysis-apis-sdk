# Entity: seo_analysi

main: kit: entity: seo_analysi: {

  alias: field: {}

  fields: {
    headings: {
      h: "Headings"
      n: "headings"
      r: false
      sh: "Heading tags analysis"
      t: "`$OBJECT`"
    }
    images: {
      h: "Images"
      n: "images"
      r: false
      t: "`$OBJECT`"
    }
    metaDescription: {
      h: "Meta Description"
      n: "metaDescription"
      r: false
      sh: "Meta description"
      t: "`$STRING`"
    }
    score: {
      h: "Score"
      n: "score"
      r: false
      sh: "Overall SEO score"
      t: "`$NUMBER`"
    }
    timestamp: {
      fo: "date-time"
      h: "Timestamp"
      n: "timestamp"
      r: false
      sh: "Timestamp of the audit"
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
