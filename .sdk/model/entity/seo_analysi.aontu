      t: "`$STRING`"
    }
  }

  name: "seo_analysi"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/seo-audit"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "https://example.com"
                k: "query"
                n: "url"
                or: "url"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/seo-audit"
          q: {
            exist: [
              "url"
            ]
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "seo-audit"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
