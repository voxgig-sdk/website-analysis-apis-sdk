# Entity: tech_stack

main: kit: entity: tech_stack: {

  alias: field: {}

  fields: [
    {
      name: "category"
      req: false
      short: "Technology category"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Technology name"
      type: "`$STRING`"
    }
    {
      name: "version"
      req: false
      short: "Detected version"
      type: "`$STRING`"
    }
  ]

  name: "tech_stack"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "https://example.com"
                kind: "query"
                name: "url"
                orig: "url"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/techstack"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "techstack"
            }
          ]
          select: {
            exist: [
              "url"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.technologies`"
          }
        }
      ]
    }
  }



}
