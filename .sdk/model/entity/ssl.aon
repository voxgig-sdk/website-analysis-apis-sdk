      req: false
      short: "Certificate issuer"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "timestamp"
      req: false
      short: "Timestamp of the check"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "The analyzed URL"
      type: "`$STRING`"
    }
    {
      name: "valid"
      req: false
      short: "Whether the SSL certificate is valid"
      type: "`$BOOLEAN`"
    }
    {
      format: "date-time"
