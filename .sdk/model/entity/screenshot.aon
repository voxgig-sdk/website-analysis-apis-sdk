# Entity: screenshot

main: kit: entity: screenshot: {

  alias: field: {}

  fields: [
    {
      name: "screenshotUrl"
      req: false
      short: "URL to the captured screenshot"
      type: "`$STRING`"
    }
    {
      name: "timestamp"
      req: false
      short: "Timestamp of the capture"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "The captured URL"
      type: "`$STRING`"
    }
  ]

  name: "screenshot"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "https://example.com"
                kind: "query"
                name: "url"
                orig: "url"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/screenshot"
          parts: [
            "api"
            "screenshot"
          ]
          select: {
            exist: [
              "url"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
